{
  "_notes": [
    "ROCm side of the madengine image_spec matrix; the NVIDIA side is compat/cuda.json.",
    "Keys under releases are the values accepted by image_spec.rocm.version.",
    "therock: pip wheels from a TheRock index. rocm_pip_spec pins the stream, because an index serves every release in it.",
    "legacy: apt packages through the amdgpu-install .deb.",
    "Index locations: https://github.com/ROCm/TheRock/blob/main/RELEASES.md (10.0 stable and later) and docs/packaging/legacy_multi_arch_releases.md (earlier)."
  ],
  "default_version": "10.1",
  "bare_os_base": "ubuntu:24.04",
  "releases": {
    "7.2": {
      "default_install": "legacy",
      "legacy_installer_url": "https://repo.radeon.com/amdgpu-install/7.2/ubuntu/noble/amdgpu-install_7.2.70200-1_all.deb"
    },
    "7.13": {
      "default_install": "therock",
      "therock_index_url": "https://repo.amd.com/rocm/whl-multi-arch/",
      "rocm_pip_spec": ">=7.13,<7.14",
      "torch_index_url": {
        "therock": "https://repo.amd.com/rocm/whl-multi-arch/"
      }
    },
    "7.14": {
      "default_install": "therock",
      "therock_index_url": "https://repo.amd.com/rocm/whl-multi-arch/",
      "rocm_pip_spec": ">=7.14,<7.15",
      "torch_index_url": {
        "therock": "https://repo.amd.com/rocm/whl-multi-arch/"
      }
    },
    "10.0": {
      "default_install": "therock",
      "therock_index_url": "https://stable.repo.amd.com/rocm/whl-next/",
      "rocm_pip_spec": ">=10.0,<10.1",
      "torch_index_url": {
        "therock": "https://stable.repo.amd.com/rocm/whl-next/"
      }
    },
    "10.1": {
      "default_install": "therock",
      "therock_index_url": "https://stable.repo.amd.com/rocm/whl-next/",
      "rocm_pip_spec": ">=10.1,<10.2",
      "torch_index_url": {
        "therock": "https://stable.repo.amd.com/rocm/whl-next/"
      }
    },
    "nightly": {
      "default_install": "therock",
      "therock_index_url": "https://nightly.repo.amd.com/rocm/whl-next/",
      "torch_index_url": {
        "therock": "https://nightly.repo.amd.com/rocm/whl-next/"
      }
    }
  }
}
